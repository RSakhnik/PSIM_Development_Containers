{
  "PilotEnv": {
    "RepositoryRoot": "../..",
    "ListenUrl": "http://127.0.0.1:17070",
    "PublicHost": "360pilot.ru",
    "PublicScheme": "https",
    "ControlPublicPort": 17443,
    "WebPublicPortStart": 18000,
    "WebPublicPortEnd": 18049,
    "AdminPublicPortStart": 19000,
    "AdminPublicPortEnd": 19049,
    "MinimumFreeDiskGiB": 20,
    "PerEnvironmentMemoryGiB": 8,
    "SafetyReserveMemoryGiB": 8,
    "OperationConcurrency": 2,
    "DisableMemoryAdmission": false,
    "SecretFile": ".pilot-runtime/api/secrets.json",
    "LicenseFile": ".pilot-runtime/api/license/current.pilotlic",
    "ConfigurationFile": "configuration_pilot-bim_ru.pilotcfx",
    "DatabaseFile": ".pilot-runtime/api/pilot-env.db",
    "PowerShellExecutable": "pwsh.exe"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
